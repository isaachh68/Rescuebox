import React, { useState } from 'react';
import { base44 } from "@/api/base44Client";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { AlertTriangle, Trash2 } from 'lucide-react';
import { AnimatePresence } from "framer-motion";

import AlertCard from "../components/emergency/AlertCard";
import StatsBar from "../components/emergency/StatsBar";
import SimulateButton from "../components/emergency/SimulateButton";

export default function Dashboard() {
  const [activeTab, setActiveTab] = useState('activas');
  const queryClient = useQueryClient();

  const { data: alerts = [], isLoading } = useQuery({
    queryKey: ['alerts'],
    queryFn: () => base44.entities.EmergencyAlert.list('-timestamp'),
    refetchInterval: 3000 // Actualiza cada 3 segundos
  });

  const createMutation = useMutation({
    mutationFn: (data) => base44.entities.EmergencyAlert.create(data),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['alerts'] })
  });

  const resolveMutation = useMutation({
    mutationFn: (id) => base44.entities.EmergencyAlert.update(id, {
      status: 'resuelta',
      resolved_at: new Date().toISOString()
    }),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['alerts'] })
  });

  const deleteResolvedMutation = useMutation({
    mutationFn: async () => {
      const resolved = alerts.filter(a => a.status === 'resuelta');
      await Promise.all(resolved.map(a => base44.entities.EmergencyAlert.delete(a.id)));
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['alerts'] })
  });

  const activeAlerts = alerts.filter(a => a.status === 'activa');
  const resolvedAlerts = alerts.filter(a => a.status === 'resuelta');

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
      <div className="max-w-7xl mx-auto p-6 md:p-8">
        {/* Header */}
        <div className="mb-8">
          <div className="flex items-center gap-4 mb-4">
            <div className="p-4 bg-red-600 rounded-xl">
              <AlertTriangle className="w-8 h-8 text-white" />
            </div>
            <div>
              <h1 className="text-3xl md:text-4xl font-bold text-white">
                Panel de Emergencias
              </h1>
              <p className="text-gray-400 mt-1">Sistema de Control ESP32</p>
            </div>
          </div>

          {/* Live indicator */}
          <div className="flex items-center gap-2">
            <div className="w-3 h-3 bg-green-500 rounded-full animate-pulse" />
            <span className="text-green-400 text-sm font-medium">Sistema Activo</span>
          </div>
        </div>

        {/* Stats */}
        <div className="mb-8">
          <StatsBar alerts={alerts} />
        </div>

        {/* Actions */}
        <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
          <Tabs value={activeTab} onValueChange={setActiveTab} className="w-full md:w-auto">
            <TabsList className="bg-gray-800 border border-gray-700">
              <TabsTrigger value="activas" className="data-[state=active]:bg-red-600">
                Alertas Activas ({activeAlerts.length})
              </TabsTrigger>
              <TabsTrigger value="resueltas" className="data-[state=active]:bg-gray-700">
                Resueltas ({resolvedAlerts.length})
              </TabsTrigger>
            </TabsList>
          </Tabs>

          <div className="flex gap-3 w-full md:w-auto">
            <SimulateButton onCreateAlert={createMutation.mutate} />
            {resolvedAlerts.length > 0 && (
              <Button
                variant="outline"
                onClick={() => deleteResolvedMutation.mutate()}
                className="border-gray-700 text-gray-300 hover:bg-gray-800"
              >
                <Trash2 className="w-4 h-4 mr-2" />
                Limpiar Resueltas
              </Button>
            )}
          </div>
        </div>

        {/* Alerts Grid */}
        {isLoading ? (
          <div className="text-center py-12">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto" />
            <p className="text-gray-400 mt-4">Cargando alertas...</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <AnimatePresence>
              {activeTab === 'activas' && activeAlerts.length === 0 && (
                <div className="col-span-full text-center py-12">
                  <div className="w-16 h-16 bg-green-500 bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <AlertTriangle className="w-8 h-8 text-green-500" />
                  </div>
                  <h3 className="text-xl font-semibold text-white mb-2">
                    Sin Alertas Activas
                  </h3>
                  <p className="text-gray-400">
                    El sistema está funcionando normalmente
                  </p>
                </div>
              )}
              
              {activeTab === 'activas' && activeAlerts.map(alert => (
                <AlertCard
                  key={alert.id}
                  alert={alert}
                  onResolve={resolveMutation.mutate}
                />
              ))}

              {activeTab === 'resueltas' && resolvedAlerts.length === 0 && (
                <div className="col-span-full text-center py-12">
                  <p className="text-gray-400">No hay alertas resueltas</p>
                </div>
              )}

              {activeTab === 'resueltas' && resolvedAlerts.map(alert => (
                <AlertCard key={alert.id} alert={alert} />
              ))}
            </AnimatePresence>
          </div>
        )}

        {/* Info footer */}
        <div className="mt-12 p-6 bg-gray-800 bg-opacity-50 rounded-lg border border-gray-700">
          <h3 className="text-lg font-semibold text-white mb-3">
            ℹ️ Información del Sistema
          </h3>
          <div className="space-y-2 text-sm text-gray-300">
            <p>
              • Este panel se actualiza automáticamente cada 3 segundos
            </p>
            <p>
              • Para conectar con tu ESP32, necesitarás configurar una comunicación HTTP/WebSocket
            </p>
            <p>
              • El ESP32 debe enviar datos en formato JSON con: location, severity, button_number, timestamp
            </p>
            <p>
              • Usa el botón "Simular Alerta" para probar el sistema mientras configuras tu ESP32
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}
