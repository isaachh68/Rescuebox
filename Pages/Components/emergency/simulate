import React, { useState } from 'react';
import { Button } from "@/components/ui/button";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Plus } from 'lucide-react';

export default function SimulateButton({ onCreateAlert }) {
  const [open, setOpen] = useState(false);
  const [formData, setFormData] = useState({
    location: '',
    severity: 'moderado',
    button_number: 1
  });

  const handleSubmit = async (e) => {
    e.preventDefault();
    await onCreateAlert({
      ...formData,
      timestamp: new Date().toISOString(),
      status: 'activa'
    });
    setOpen(false);
    setFormData({ location: '', severity: 'moderado', button_number: 1 });
  };

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild>
        <Button className="bg-blue-600 hover:bg-blue-700">
          <Plus className="w-4 h-4 mr-2" />
          Simular Alerta
        </Button>
      </DialogTrigger>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>Simular Alerta de Emergencia</DialogTitle>
        </DialogHeader>
        <form onSubmit={handleSubmit} className="space-y-4">
          <div>
            <Label>Ubicación</Label>
            <Input
              value={formData.location}
              onChange={(e) => setFormData({...formData, location: e.target.value})}
              placeholder="Ej: Planta Baja - Sala A"
              required
            />
          </div>
          <div>
            <Label>Nivel de Gravedad</Label>
            <Select value={formData.severity} onValueChange={(v) => setFormData({...formData, severity: v})}>
              <SelectTrigger>
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="leve">Leve</SelectItem>
                <SelectItem value="moderado">Moderado</SelectItem>
                <SelectItem value="critico">Crítico</SelectItem>
              </SelectContent>
            </Select>
          </div>
          <div>
            <Label>Número de Botón</Label>
            <Select 
              value={formData.button_number.toString()} 
              onValueChange={(v) => setFormData({...formData, button_number: parseInt(v)})}
            >
              <SelectTrigger>
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                {[1,2,3,4,5,6,7].map(n => (
                  <SelectItem key={n} value={n.toString()}>Botón {n}</SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>
          <Button type="submit" className="w-full">Crear Alerta</Button>
        </form>
      </DialogContent>
    </Dialog>
  );
}
