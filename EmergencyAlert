{
  "name": "EmergencyAlert",
  "type": "object",
  "properties": {
    "location": {
      "type": "string",
      "description": "Ubicaci\u00f3n donde ocurri\u00f3 la emergencia"
    },
    "severity": {
      "type": "string",
      "enum": [
        "leve",
        "moderado",
        "critico"
      ],
      "description": "Nivel de gravedad de la emergencia"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la emergencia"
    },
    "button_number": {
      "type": "number",
      "description": "N\u00famero del bot\u00f3n presionado (1-7)"
    },
    "status": {
      "type": "string",
      "enum": [
        "activa",
        "resuelta"
      ],
      "default": "activa",
      "description": "Estado de la alerta"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora cuando se resolvi\u00f3"
    }
  },
  "required": [
    "location",
    "severity",
    "timestamp"
  ]
}
